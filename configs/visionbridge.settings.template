database:
  dsn: "/opt/VLX_VisionBridge/var/visionbridge.db" # The Data Source Name or path to the SQLite database file.

connector:
  ipc_control_in: true                  # Boolean to enable or disable IPC control socket.
  group: "visionbridge"                 # The user group assigned to the control socket for permission access.
  control_socket: "/tmp/vlx_control.sock" # The file path for the Unix domain control socket.

output:
  active: true                          # Boolean to toggle the streaming output state.
  resolution: "1920x1080"               # The final scaled output resolution (e.g., "1920x1080").
  fps: 30                               # Target frames per second.
  video_bitrate: "8000k"                # Target video encoding bitrate.
  audio_bitrate: "160k"                 # Target audio encoding bitrate.
  audio_sample_rate: 44100              # Target audio sample rate.
  destinations:
    - "rtmp://127.0.0.1:1999/streamout" # Destination URI to push the stream to.

input:
  bg_color: "black"        # Global canvas background color
  resolution: "1920x1080"  # Master canvas size
  framerate: 30                         # The processing framerate for inputs.
  carousel_delay: 5        # Delay in seconds between static images in carousel mode
  carousel_shuffle: true   # true = shuffle (random, no repeats until folder exhausted); false = natural/alphabetical order
  
  webrtc_port_min: 50000   # UDP ports for inbound WebRTC streams
  webrtc_port_max: 50050                # Maximum ephemeral UDP port for WebRTC signaling.

  overlay_server_active: true           # Boolean to enable the internal Web/WebSocket server.
  overlay_server_port: 50051            # Port for the internal Web/WebSocket server.
  media_folder_path: "/opt/VLX_VisionBridge/media" # Base path for the media directory to serve static assets.

  chromium_source:
    active: true                        # Boolean to keep the entire Chromium layer active.

    z0_active: false                    # Boolean to enable/disable a specific layer (e.g., `z0_active`).
    z0_path: ""                         # File path, directory path, or URL for the media source.
    z0_width: null                      # Width and height dimensions of the layer.
    z0_height: null                     # Width and height dimensions of the layer.
    z0_x: null                          # X and Y absolute layout coordinates of the layer.
    z0_y: null                          # X and Y absolute layout coordinates of the layer.
    z0_volume: 100                      # Volume (0-100) for native media elements.

    z1_active: false                    # Boolean to enable/disable a specific layer (e.g., `z0_active`).
    z1_path: "/opt/VLX_VisionBridge/media/intro.mp4" # File path, directory path, or URL for the media source.
    z1_width: null                      # Width and height dimensions of the layer.
    z1_height: null                     # Width and height dimensions of the layer.
    z1_x: null                          # X and Y absolute layout coordinates of the layer.
    z1_y: null                          # X and Y absolute layout coordinates of the layer.
    z1_volume: 100                      # Volume (0-100) for native media elements.

