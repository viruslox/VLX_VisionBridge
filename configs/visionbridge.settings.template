control_api:
  enable: true                          # Boolean to enable or disable the control API.
  bind_address: "127.0.0.1"             # The IP address to bind the API to.
  port: "8770"                          # The port to bind the API to.
  user: "visionbridge"                  # The Basic Auth username for the API.
  pass: "changeme"                      # The Basic Auth password for the API.
  log_unit: "visionbridge"              # The systemd log unit used for fetching logs in the UI.
