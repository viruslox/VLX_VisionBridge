# VLX VisionBridge User Profile
visionbridge_USER: "visionbridge"
visionbridge_DIR: "/opt/VLX_VisionBridge"

# Database settings
database:
  dsn: "/opt/VLX_VisionBridge/var/visionbridge.db" # SQLite database path

# Global output settings for the stream
output:
  active: false           # Keeps FFmpeg dormant (0% CPU) until a [ZMQ_CONTROL] Target=stream Enabled=true IPC command wakes it up
  resolution: "1920x1080" # Target output resolution
  fps: 30                 # Target output framerate
  video_bitrate: "6000k"  # Output video bitrate
  audio_bitrate: "160k"   # Output audio bitrate
  destinations:           # List of RTMP endpoints to stream to
    - "rtmp://localhost/live/test"

input:
  resolution: "1920x1080" # Layer's canvas size
  chromium_source:
    active: false
    z1_active: true
    z1_path: "https://example.com/lower"
    bg-color: ""
    z1_volume: 100
    z1_width: 1920
    z1_x: 0
    z1_y: 0
    z2_active: false
    z2_path: "https://example.com/middle"
    z2_volume: 100
    z2_width: 1920
    z2_x: 0
    z2_y: 0
    z3_active: false
    z3_path: "https://example.com/upper"
    z3_volume: 100
    z3_width: 1920
    z3_x: 0
    z3_y: 0
    z4_active: false
    z4_path: ""
    z4_volume: 100
    z4_width: 1920
    z4_x: 0
    z4_y: 0
    z5_active: false
    z5_path: ""
    z5_volume: 100
    z5_width: 1920
    z5_x: 0
    z5_y: 0
    z6_active: false
    z6_path: ""
    z6_volume: 100
    z6_width: 1920
    z6_x: 0
    z6_y: 0
    z7_active: false
    z7_path: ""
    z7_volume: 100
    z7_width: 1920
    z7_x: 0
    z7_y: 0

  ffmpeg_source:
    active: false
    # Layers (0-9) configured as inputs and their layouts
    # For 'local' input_type, the input_path must be a folder. Content is accepted if:
    # - video (mp4 and webm)
    # - images and audio (png and mp3)
    # - images only (png)
    # - audio only (mp3)
    layers:
      - id: 0                    # Layer ID
        active: true             # Whether this layer is processed
        input_type: "local"      # Type: 'local', 'srt', 'rtmp', 'webrtc', 'rtsp', 'ipc_audio'
        input_path: "/opt/VLX_VisionBridge/data/layer0" # Path to folder or address. For 'ipc_audio', can be dynamically set or left empty to default to '/tmp/vlx_audio.sock'.
        media: "Video+Audio"     # Which tracks to include: Video+Audio, Video, Audio
        volume: 100              # Volume percentage
        size: 1920               # Width in pixels
        x: 0                     # X position on canvas
        y: 0                     # Y position on canvas
        folder_options:
          is_folder: false       # True to treat input_path as a playlist directory
          shuffle: false         # True to shuffle the playlist
          loop: false            # True to loop the playlist
          delay_sec: 0           # Seconds of black screen delay between videos
          spacer_width: 1920
          spacer_height: 1080
          spacer_fps: 30
          spacer_sample_rate: 48000
          spacer_color: "black"
          spacer_image: ""       # Leave empty to use spacer_color, or provide an absolute path to a PNG/JPG
